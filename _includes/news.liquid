<div class="news">
  {% if site.data.news.size > 0 %}
    {% assign news = site.data.news | where_exp: "item", "item.hidden != true" | sort: "date" | reverse %}
    {% assign news_size = news | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <td style="width: 20%; font-weight: 400;">{{ item.date | date: '%b %d, %Y' }}</td>
            <td style="font-weight: 400;">{{ item.content | emojify }}</td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
